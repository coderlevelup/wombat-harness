Screen {
    layout: vertical;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 32;
    border-right: solid $primary-darken-2;
    padding: 0 1;
}

#sidebar-title, #log-title {
    color: $text-muted;
    text-style: bold;
    margin: 1 0 0 0;
}

#targets {
    height: 1fr;
    border: none;
    background: transparent;
}

#targets:disabled {
    opacity: 60%;
}

#main {
    width: 1fr;
    padding: 0 1;
}

#controls {
    height: auto;
    margin: 1 0;
}

#controls Button {
    margin-right: 1;
}

#status {
    width: 1fr;
    content-align: right middle;
    height: 3;
    color: $text-muted;
}

#status.running  { color: $success; text-style: bold; }
#status.teardown { color: $warning; text-style: bold; }

#log {
    height: 1fr;
    border: round $primary-darken-2;
    background: $surface;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-color: $primary-darken-2;
    scrollbar-color-hover: $primary;
}
